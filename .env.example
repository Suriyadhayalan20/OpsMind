# Copy this file to .env and fill it in.
# NEVER commit .env to GitHub.

# Which AI to use:
#   claude = paid, best answers (needs ANTHROPIC_API_KEY)
#   gemini = free plan, runs in Google's cloud (needs GEMINI_API_KEY)
#   ollama = free, runs on your computer (needs Ollama installed)
LLM_PROVIDER=claude

# ---- Claude settings ----
ANTHROPIC_API_KEY=your-key-here
LLM_MODEL=claude-opus-5-5
# Cheaper while practising:  LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=medium

# ---- Gemini settings ----
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-flash-latest
# If you get "busy" (503) errors, use the lighter model:  GEMINI_MODEL=gemini-flash-lite-latest

# ---- Ollama settings ----
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
